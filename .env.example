# LLM provider key for the agenthood Autonomous Runtime (opencode-go provider).
# Copy this file to .env and fill in your key. Never commit .env.
OPENCODE_API_KEY=

# Optional: Groq fallback (free at console.groq.com). Used when the primary provider is unavailable.
# GROQ_API_KEY=

# Atlaslink daemon bind address and port (defaults: 127.0.0.1:3000)
ATLASLINK_HOST=127.0.0.1
ATLASLINK_PORT=3000

# Log verbosity: debug | info | warn | error (default: info). Structured JSON
# goes to stderr; stdout stays reserved for human-facing output.
# ATLASLINK_LOG_LEVEL=info

# Directory for runtime artifacts such as checkpoints (default: data)
# ATLASLINK_DATA_DIR=data

# Comma-separated browser origins allowed by CORS.
# ATLASLINK_CORS_ORIGINS=http://localhost:3001,https://atlas.flabs.tech

# Re-anchor the checkpoint delta channel every N persisted rows (default: 10)
# ATLASLINK_CHECKPOINT_SNAPSHOT_EVERY=10

# Optional: bearer token for the M3 task API (POST/GET /tasks, cancel,
# per-session events). Set this before exposing the daemon on any non-loopback
# address — without it the server REFUSES to bind 0.0.0.0 and logs a warning
# otherwise, because the API is write-capable and spends provider quota.
# ATLASLINK_API_TOKEN=

# Optional: signing secret for dashboard login JWTs (/v1/auth/*). When set,
# the auth gate accepts JWTs and API keys in addition to the shared bearer.
# Generate one with: openssl rand -hex 32
# ATLASLINK_JWT_SECRET=

# Optional: HMAC-SHA256 secret for signed webhook payloads and signed inbound
# requests. Unset means signing throws and verification fails closed.
# ATLASLINK_SIGNING_SECRET=

# Session event store, in priority order:
# 1. ATLASLINK_DATABASE_URL set → managed Postgres (migrations run at boot).
# 2. Otherwise → embedded SQLite at ATLASLINK_SQLITE_DIR
#    (data/atlaslink.sqlite by default) — zero setup, survives restarts.
# 3. ATLASLINK_DURABILITY=inmemory → in-process store (ephemeral, tests).
# ATLASLINK_DATABASE_URL=postgresql://user:password@localhost:5432/atlaslink
# ATLASLINK_SQLITE_DIR=data/atlaslink.sqlite
# ATLASLINK_DURABILITY=inmemory
