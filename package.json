{
  "name": "atlaslink",
  "version": "1.0.0",
  "description": "Multi-agent orchestrator and Agenthood proof-of-concept with a live diagram-flow UI",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "run": "tsx src/server.ts --run",
    "insights": "tsx src/insights.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "agenthood",
    "orchestrator",
    "agents",
    "multi-agent"
  ],
  "author": "Fabio Ritzel Borges",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.0",
    "agenthood": "^3.55.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "c8": "^10.1.3",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.23.0",
    "semantic-release": "^24.2.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.29.0"
  }
}
