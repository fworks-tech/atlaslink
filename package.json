{
  "name": "atlaslink",
  "version": "1.0.0",
  "description": "Multi-agent orchestrator and Agenthood proof-of-concept with a live diagram-flow UI",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "run": "tsx src/server.ts --run",
    "insights": "tsx src/insights.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agenthood",
    "orchestrator",
    "agents",
    "multi-agent"
  ],
  "author": "Fabio Ritzel Borges",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "agenthood": "file:../agenthood",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
