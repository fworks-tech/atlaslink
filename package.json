{
  "name": "atlaslink",
  "version": "1.0.0",
  "description": "Multi-agent orchestrator and Agenthood proof-of-concept with a live diagram-flow UI",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "run": "tsx src/server.ts --run",
    "insights": "tsx src/insights.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "compose": "npx --yes wgc@0.132.2 router compose -i src/subgraphs/compose.yaml -o router-config.json",
    "router": "tsx src/router/start.ts",
    "router:smoke": "tsx src/router/smoke.ts",
    "semantic-release": "semantic-release",
    "codegen": "graphql-codegen --config codegen.yml"
  },
  "keywords": [
    "agenthood",
    "orchestrator",
    "agents",
    "multi-agent"
  ],
  "author": "Fabio Ritzel Borges",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@apollo/subgraph": "^2.15.1",
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "agenthood": "^3.71.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "graphql": "^17.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "c8": "^12.0.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint": "^10.13.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
