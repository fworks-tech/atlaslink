# Optional: daemon origin the /api/* rewrite proxies to (server-side env).
# Defaults to http://127.0.0.1:3000. Also the value the client should send
# fetch/EventSource requests to when not going through the proxy.
NEXT_PUBLIC_ATLASLINK_API_URL=

# Optional: bearer token for the atlaslink API, required only when the daemon
# gate is armed (ATLASLINK_API_TOKEN set on the daemon). Loopback dev needs
# nothing. Exposed to the client bundle — dev-only convenience, never a secret.
NEXT_PUBLIC_ATLASLINK_API_TOKEN=