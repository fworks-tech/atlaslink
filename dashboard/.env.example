# Server-side env — read by dashboard/src/app/api/[...path]/route.ts (dev shell,
# Vercel project settings, or Fly.io secrets). Never prefixed NEXT_PUBLIC_*.

# Daemon origin the /api/* proxy forwards to. Defaults to the loopback daemon;
# production points at the Fly.io backend (no trailing slash).
ATLASLINK_API_URL=http://127.0.0.1:3000

# Bearer token for the daemon gate. Set ONLY when ATLASLINK_API_TOKEN is armed
# on the daemon (non-loopback bind fails closed without it). Injected
# server-side by the proxy — the browser bundle never sees it.
ATLASLINK_API_TOKEN=