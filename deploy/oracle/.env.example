# Copy to the repo root on the Oracle VM as .env (the repo gitignores .env*),
# then fill in the real values. ATLASLINK_API_TOKEN must match the value stored
# on Vercel so the dashboard proxy authenticates against the gate.
#
# Any single-line value is accepted; no quotes needed.

# Bearer token for the task API. Copy from your Vercel env vars.
ATLASLINK_API_TOKEN=REPLACE_WITH_DAEMON_TOKEN

# Signing secret for dashboard login JWTs (/v1/auth/*). Generate with:
#   openssl rand -hex 32
# ATLASLINK_JWT_SECRET=

# opencode-go (zen/go tier) key for the LLM provider. Never commit.
OPENCODE_API_KEY=REPLACE_WITH_OPENCODE_KEY

# Comma-separated CORS origins the daemon allows. The Vercel dashboard makes
# server-side BFF requests, so this is defense-in-depth, not a hard requirement.
ATLASLINK_CORS_ORIGINS=https://atlas.flabs.tech
