# Caddy gateway for the Oracle Free Tier daemon.
#
# Two hosts share this file:
#   - :80            — plain HTTP (fallback, health checks, ACME challenge)
#   - api.atlas.flabs.tech — TLS with Let's Encrypt (primary)
#
# The backend never listens directly on the internet; Caddy fronts it on
# both :80 (redirects to HTTPS) and :443 (proxies to backend:3000).

:80 {
	# Redirect plain HTTP to the HTTPS host (except ACME challenges).
	redir https://api.atlas.flabs.tech{uri} permanent
}

api.atlas.flabs.tech {
	reverse_proxy backend:3000
}
