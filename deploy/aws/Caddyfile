# Caddy gateway for the AWS deployment (#328).
#
# `staging.atlas.flabs.tech` and `api.atlas.flabs.tech` both front the single
# EC2 stack. Production cut over in #329; Render stays available (it sleeps on
# the free tier) until the soak ends, then is removed.
#
# Routing: /graphql and /health/ready go to the Cosmo router (federated graph
# edge); everything else reaches the daemon.
{
	# Pin the production ACME directory: the staging CA issues certs browsers reject.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# Caddy's automatic HTTPS owns :80 for redirects and ACME challenges; a
# catch-all block here would shadow the challenge path.
staging.atlas.flabs.tech, api.atlas.flabs.tech {
	handle /graphql* {
		reverse_proxy router:3002
	}

	handle /health/ready* {
		reverse_proxy router:3002
	}

	handle {
		reverse_proxy backend:3000
	}
}
